{
  "version": 1,
  "publisher": "webmp3",
  "github_repo": "gtotaro86-ai/sakura-cloud-builds",
  "llama_cpp_min_build_for_spark": 10828,
  "adapters": [
    {
      "id": "minimax-m31-flash",
      "match": {
        "repo_ids": ["MiniMaxAI/MiniMax-M3.1-Flash"],
        "name_contains": ["minimax-m3.1-flash", "minimax-m3.1"]
      },
      "route": "existing_pipeline",
      "workflow": "minimax-m31.yml",
      "finalize_workflow": "minimax-m31-finalize.yml",
      "quants": ["Q2_K", "Q3_K_M", "Q4_K_M", "Q5_K_M"],
      "recompute": false,
      "requires_custom_runtime": true,
      "notes": "Existing workflow may use a pinned patched llama.cpp. Stock b11669 already contains the minimax_m3 string. Do not add another patch. Do not start a second full build while a run is active."
    },
    {
      "id": "flint-bf16",
      "match": {
        "name_contains": ["flint"]
      },
      "route": "existing_pipeline",
      "workflow": "flint-bf16.yml",
      "quants": ["Q4_K_M", "Q5_K_M"],
      "recompute": false,
      "requires_custom_runtime": true,
      "notes": "Existing Flint workflow. Do not add a new patch. Do not recompute without an explicit new revision."
    },
    {
      "id": "sage-bf16",
      "match": {
        "name_contains": ["sage"]
      },
      "route": "existing_pipeline",
      "workflow": "sage-bf16.yml",
      "quants": ["Q4_K_M", "Q5_K_M"],
      "recompute": false,
      "requires_custom_runtime": true,
      "notes": "Existing Sage workflow. Do not add a new patch."
    },
    {
      "id": "standard-llamacpp",
      "match": {
        "model_types": ["llama", "qwen2", "qwen3", "gemma", "gemma2", "gemma3", "phi", "phi3", "mistral", "smollm", "stablelm"]
      },
      "route": "standard",
      "quants": ["Q2_K", "Q3_K_M", "Q4_K_M", "Q5_K_M"],
      "local_max_bytes": 1610612736,
      "native": true,
      "requires_custom_runtime": false,
      "notes": "Stock llama.cpp types. Requant or convert only with an unpatched llama.cpp. No local runtime fork."
    },
    {
      "id": "spark2_5-runtime",
      "match": {
        "model_types": ["spark2_5"],
        "architectures": ["Spark2_5ForCausalLM"],
        "repo_ids": ["XHToken/Spark-X2.6-4B", "bartowski/Spark-X2.6-4B-GGUF", "XHToken/Spark-X2.6-4B-GGUF"]
      },
      "route": "agent_runtime",
      "notes": "Agent runtime, not a default quantization target. GGUF architecture spark2_5 needs llama.cpp b10828 or later. Preferred weights: bartowski Q4_K_M (imatrix, smaller than the official Q4_K_M)."
    }
  ]
}
